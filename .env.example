# Copie para .env (cp .env.example .env) e ajuste os valores. O .env não é versionado.
#
# O mesmo arquivo é usado de duas formas:
# - docker compose: lê o .env para interpolar o docker-compose.yml. Dentro dos containers,
#   host do banco e do SMTP são definidos pelo próprio compose (db e mailpit).
# - dotnet run: a API carrega o .env da raiz (DotEnvLoader). Variáveis já definidas no
#   sistema têm precedência sobre este arquivo.

# --- Banco (docker compose) ---
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque-esta-senha

# --- Banco (dotnet run, fora do container) ---
# Use as mesmas credenciais definidas acima.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=oficina;Username=oficina;Password=troque-esta-senha

# --- JWT (chave com pelo menos 32 bytes) ---
Jwt__SigningKey=troque-por-uma-chave-local-com-pelo-menos-32-bytes

# --- Origem publica dos links enviados por e-mail ---
# Use http://localhost:8080 no Docker Compose ou https://localhost:5001 no dotnet run.
App__PublicBaseUrl=http://localhost:8080

# --- SMTP (Mailpit local por padrão) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=noreply@oficina.local
Smtp__EnableSsl=false

# Para um provedor SMTP real, substitua os valores acima e, se necessário, informe:
# Smtp__Username=seu-usuario
# Smtp__Password=sua-senha-ou-app-password

# --- Reservado para a futura integracao de webhooks (K8S-3) ---
# Webhooks__BudgetDecisionToken=gere-um-token-secreto
