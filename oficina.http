### Service orders - Associate service A and request approval
PUT {{baseUrl}}/api/v1/service-orders
Authorization: Bearer {{issueToken.response.body.$.accessToken}}
Content-Type: application/json

{
  "serviceOrderId": "{{openSingleServiceOrder.response.body.$.id}}",
  "workshopServiceIds": [
    "{{createWeightedServiceA.response.body.$.id}}"
  ]
}

### Service orders - List service orders
# As respostas de ordens de serviço retornam status pelo nome do enum, por exemplo "Created".
GET {{baseUrl}}/api/v1/service-orders
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - List by status priority (oldest first within each status)
# InExecution > AwaitingApproval > InDiagnosis > Received; ID breaks ties.
# Created, Rejected, Finalized, Delivered and null statuses are excluded from this query only.
GET {{baseUrl}}/api/v1/service-orders/status
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Get the weighted service order by ID
GET {{baseUrl}}/api/v1/service-orders/{{openWeightedServiceOrder.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Budgets - List budget versions
GET {{baseUrl}}/api/v1/budgets?page=1&pageSize=20
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Approve the weighted service order
POST {{baseUrl}}/api/v1/service-orders/{{openWeightedServiceOrder.response.body.$.id}}/approve
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Approve the second service order
POST {{baseUrl}}/api/v1/service-orders/{{openSingleServiceOrder.response.body.$.id}}/approve
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Finalize the weighted service order
POST {{baseUrl}}/api/v1/service-orders/{{openWeightedServiceOrder.response.body.$.id}}/finalize
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Finalize the second service order
POST {{baseUrl}}/api/v1/service-orders/{{openSingleServiceOrder.response.body.$.id}}/finalize
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Metrics - Workshop service execution time
# A resposta tera averageTimeMinutes preenchido depois da finalizacao das OS.
GET {{baseUrl}}/api/v1/metrics/workshop-service/execution-time
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Deliver the weighted service order
POST {{baseUrl}}/api/v1/service-orders/{{openWeightedServiceOrder.response.body.$.id}}/deliver
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Deliver the second service order
POST {{baseUrl}}/api/v1/service-orders/{{openSingleServiceOrder.response.body.$.id}}/deliver
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Track the weighted order by document (public)
GET {{baseUrl}}/api/v1/service-orders/{{openWeightedServiceOrder.response.body.$.id}}/track?document=52998224725

### Service orders - Track all orders for the customer (public)
GET {{baseUrl}}/api/v1/service-orders/track?document=52998224725

### Schedules - List schedules
GET {{baseUrl}}/api/v1/schedules
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Schedules - Filter schedules by date (optional)
# Substitua a data por uma data de agendamento existente no ambiente.
GET {{baseUrl}}/api/v1/schedules?date=2026-10-29
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service order history 1/2 - List all history
GET {{baseUrl}}/api/v1/service-order-history
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service order history 2/2 - List history for the created order
GET {{baseUrl}}/api/v1/service-order-history/service-order/{{openWeightedServiceOrder.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

###############################################################################
# Service orders - open with items
# Abre a OS ja com servicos e pecas e a leva direto para AwaitingApproval
# (sem checklist e sem mecanico). Registra o historico Created, Received,
# InDiagnosis e AwaitingApproval, abre o orcamento, reserva o estoque das pecas
# e envia um unico e-mail com todos os dados para o cliente aprovar ou rejeitar.
# Validacoes (cliente, veiculo, servicos, pecas e estoque) rodam antes de gravar
# qualquer coisa; o motivo de uma recusa vem no campo "detail".
###############################################################################

### Service orders with items 1/4 - Open service order reusing existing customer and vehicle
# Cliente localizado pelo documento e veiculo pela placa; os demais dados so
# sao usados quando o documento ou a placa ainda nao estao cadastrados.
# @name openServiceOrderWithItems
POST {{baseUrl}}/api/v1/service-orders/with-items
Authorization: Bearer {{issueToken.response.body.$.accessToken}}
Content-Type: application/json

{
  "customer": {
    "document": "{{createCustomer.response.body.$.document}}"
  },
  "vehicle": {
    "plate": "{{createVehicle.response.body.$.plate}}"
  },
  "description": "OS aberta com servicos e pecas",
  "workshopServiceIds": [
    "{{createWeightedServiceA.response.body.$.id}}"
  ],
  "parts": [
    {
      "partId": "{{createPart.response.body.$.id}}",
      "quantity": 2
    }
  ]
}

### Service orders with items 2/4 - Open service order registering a new customer and vehicle
# Documento e placa ainda nao cadastrados: cliente e veiculo sao criados com os
# dados informados, somente depois de todas as validacoes passarem.
# @name openServiceOrderWithItemsNewCustomer
POST {{baseUrl}}/api/v1/service-orders/with-items
Authorization: Bearer {{issueToken.response.body.$.accessToken}}
Content-Type: application/json

{
  "customer": {
    "document": "111.444.777-35",
    "name": "Cliente Novo",
    "email": "cliente.novo@example.com",
    "telephoneNumber": "+5511988887777"
  },
  "vehicle": {
    "plate": "QWE1R23",
    "brand": "Ford",
    "model": "Ka",
    "year": 2019,
    "category": 1
  },
  "description": "OS aberta cadastrando cliente e veiculo",
  "workshopServiceIds": [
    "{{createWeightedServiceA.response.body.$.id}}"
  ],
  "parts": [
    {
      "partId": "{{createPart.response.body.$.id}}",
      "quantity": 2
    }
  ]
}

### Service orders with items 3/4 - Get the service order opened with items
GET {{baseUrl}}/api/v1/service-orders/{{openServiceOrderWithItems.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders with items 4/4 - List history (Created, Received, InDiagnosis, AwaitingApproval)
GET {{baseUrl}}/api/v1/service-order-history/service-order/{{openServiceOrderWithItems.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Budgets - Get a budget by ID (after setting budgetId above)
GET {{baseUrl}}/api/v1/budgets/{{budgetId}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

###############################################################################
# Decisoes alternativas para uma OS em AwaitingApproval
# Escolha apenas uma acao por OS. Os links de notificacao sao publicos e usam
# budgetId; os endpoints da OS exigem o token tecnico.
###############################################################################

### Service orders - Approve the order opened with items
POST {{baseUrl}}/api/v1/service-orders/{{openServiceOrderWithItems.response.body.$.id}}/approve
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Service orders - Cancel the order opened with a new customer
POST {{baseUrl}}/api/v1/service-orders/{{openServiceOrderWithItemsNewCustomer.response.body.$.id}}/cancel
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Notifications - Approve a budget via public link (alternative to POST /approve)
# Use o ID do orcamento de uma OS que ainda esteja em AwaitingApproval.
GET {{baseUrl}}/api/v1/notifications/approveBudget?budgetId={{budgetId}}

### Notifications - Reject a budget via public link (alternative to POST /cancel)
# Use o ID do orcamento de outra OS que ainda esteja em AwaitingApproval.
GET {{baseUrl}}/api/v1/notifications/rejectBudget?budgetId={{budgetId}}

###############################################################################
# Conferencia de e-mails no Mailpit (http://localhost:8025)
# Filtre pelo destinatario ficticio e pelo ID da OS usada no fluxo.
# Cada OS do fluxo Created -> Delivered produz sete notificacoes de status.
# Uma OS cancelada apos AwaitingApproval produz cinco. Cada retorno para
# aprovacao seguido de nova aprovacao acrescenta duas notificacoes.
# Os links do orcamento usam App__PublicBaseUrl (http://localhost:8080 no Docker).
#
# Limpeza opcional
#
# Execute individualmente e somente depois do fluxo principal. Nao existe DELETE
# para ordens de servico; por isso, o banco pode manter referencias que impeçam a
# exclusao do cliente ou da peca. Nesse caso, preserve os recursos ou recrie o
# banco de desenvolvimento. O endpoint identify/register cria um segundo veiculo;
# a unica request DELETE abaixo demonstra a operacao com esse segundo ID. Exclua
# tambem o primeiro veiculo manualmente se quiser desativar ambos.
###############################################################################

### Vehicles 6/6 - Delete vehicle created by identify/register
DELETE {{baseUrl}}/api/v1/vehicles/{{identifyCustomerAndRegisterVehicle.response.body.$.vehicle.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Services 6/6 - Delete workshop service A
DELETE {{baseUrl}}/api/v1/workshop-services/{{createWeightedServiceA.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Services - Delete workshop service B
DELETE {{baseUrl}}/api/v1/workshop-services/{{createWeightedServiceB.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Mechanics 5/5 - Delete mechanic
DELETE {{baseUrl}}/api/v1/mechanics/{{createMechanic.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Parts 6/6 - Delete part (pode falhar se a ordem ainda a referenciar)
DELETE {{baseUrl}}/api/v1/parts/{{createPart.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}

### Customers 5/5 - Delete customer (pode falhar se a ordem ainda o referenciar)
DELETE {{baseUrl}}/api/v1/customers/{{createCustomer.response.body.$.id}}
Authorization: Bearer {{issueToken.response.body.$.accessToken}}
